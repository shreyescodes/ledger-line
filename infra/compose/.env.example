# Local development only. `make up` copies this file to .env (which git ignores).
# Throwaway credentials for containers on your own machine. Never reuse them anywhere.
POSTGRES_PASSWORD=local-postgres-only
SERVICE_DB_PASSWORD=local-services-only
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=local-keycloak-only
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-grafana-only
